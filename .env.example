# Database Postgres (Neon, Supabase, o un'istanza locale).
# È la stringa che usa l'applicazione: dove c'è un pooler, è quella *pooled*.
DATABASE_URL="postgresql://utente:password@localhost:5432/finanze?schema=public"

# Stessa base dati, ma connessione *diretta*, senza pooler: su Neon è l'host
# senza `-pooler`. La usa solo il servizio `migrate`.
#
# Non è un dettaglio da rimandare: il pooler di Neon è PgBouncer in modalità
# transazione, dove `prisma migrate deploy` non riesce ad applicare una
# migrazione. Leggere quelle già applicate funziona anche dal pooler, quindi
# finché non cambia lo schema sembra tutto a posto e il guasto arriva al primo
# cambio di schema. Se il database non ha un pooler davanti, lasciala vuota:
# si ricade su DATABASE_URL.
DIRECT_DATABASE_URL=""

# Chiave usata da Auth.js per firmare i cookie di sessione.
# Generane una con: npx auth secret   (oppure: openssl rand -base64 32)
# Cambiarla scollega tutte le sessioni attive; le password non ne risentono.
AUTH_SECRET=""

# URL pubblico dell'applicazione. In sviluppo va bene questo.
#
# In produzione dipende da come si raggiunge l'app:
#   - solo dalla LAN, per indirizzo IP  ->  lasciarlo VUOTO. Il codice imposta
#     `trustHost: true`, quindi Auth.js ricava l'host da ogni richiesta e l'app
#     risponde uguale per IP, per nome o da qualunque dispositivo. Fissarlo
#     romperebbe tutti gli indirizzi diversi da quello scritto qui.
#   - dietro un dominio pubblico  ->  valorizzarlo con quello (https://…): a
#     quel punto l'indirizzo è uno solo e fissarlo evita sorprese sui redirect.
AUTH_URL="http://localhost:3000"

# Facoltativo: se valorizzate, in pagina di login compare "Continua con Google".
# L'URL di callback da registrare è <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Solo per l'esecuzione in container --------------------------------------

# Profili di Docker Compose da attivare. Vuoto (o assente) avvia la sola
# applicazione, raggiungibile dalla LAN. `public` accende anche il tunnel
# Cloudflare che la espone su internet.
# COMPOSE_PROFILES="public"

# Token del tunnel, da Cloudflare Zero Trust > Networks > Tunnels.
# Serve solo con il profilo `public`.
# TUNNEL_TOKEN=""

# Dove `backup-db.sh` deposita i dump, e per quanti giorni li tiene.
# BACKUP_DIR="/var/backups/finanze"
# KEEP_DAYS="30"

# Immagine usata per `pg_dump`. Deve avere una versione **maggiore o uguale**
# a quella del server Neon (la vedi nella console): pg_dump si rifiuta di
# leggere un server più recente di sé, mentre uno più vecchio lo legge senza
# problemi. Il default segue la versione che Neon serve oggi.
# PG_IMAGE="postgres:18"
