# Database Postgres (Supabase, Neon, Vercel Postgres o un'istanza locale).
DATABASE_URL="postgresql://utente:password@localhost:5432/finanze?schema=public"

# Chiave usata da Auth.js per firmare i cookie di sessione.
# Generane una con: npx auth secret   (oppure: openssl rand -base64 32)
AUTH_SECRET=""

# URL pubblico dell'applicazione (in sviluppo va bene questo).
AUTH_URL="http://localhost:3000"

# Facoltativo: se valorizzate, in pagina di login compare "Continua con Google".
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Invio delle email (benvenuto, recupero password, notifica delle spese).
# Servono tutte e due: se ne manca una l'app funziona lo stesso e non spedisce
# nulla, scrivendo in log quale delle due manca. È quello che serve in
# sviluppo, nei test e durante il build.
#
# La chiave si genera su Brevo in "SMTP e API" → "Chiavi API e MCP";
# il mittente va prima verificato in "Mittenti, dominio, IP".
BREVO_API_KEY=""
MAIL_FROM=""

# Il nome che si legge accanto al mittente. Facoltativo: senza, è "Splitter".
MAIL_FROM_NAME=""
